<?xml version="1.0" encoding="utf-8"?>
<!--
    Ad attribution badge background drawable.
    Used by native_ad_layout.xml for the "Ad" label badge.
    AdMob policy requires a clearly visible attribution label on all native ads.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FFB300" />
    <corners android:radius="3dp" />
</shape>
