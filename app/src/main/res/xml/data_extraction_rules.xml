<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31+) data extraction rules.
     Required for targetSdk >= 31. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="app_settings.xml" />
        <include domain="database" path="." />
        <exclude domain="database" path="attendance_database" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="app_settings.xml" />
        <include domain="database" path="." />
        <exclude domain="database" path="attendance_database" />
    </device-transfer>
</data-extraction-rules>
