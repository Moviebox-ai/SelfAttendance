<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31+) data extraction rules.
     allowBackup=false so we exclude everything from cloud backup
     and device-to-device transfer. Required for targetSdk >= 31. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="business_trial_prefs.xml" />
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="app_settings.xml" />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="business_trial_prefs.xml" />
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="app_settings.xml" />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
