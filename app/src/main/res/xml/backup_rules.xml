<?xml version="1.0" encoding="utf-8"?>
<!-- Pre-Android 12 backup exclusion rules.
     Excludes all local data (Room DB, shared prefs) from backup. -->
<full-backup-content>
    <include domain="sharedpref" path="business_trial_prefs.xml" />
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="app_settings.xml" />
    <exclude domain="external" path="." />
</full-backup-content>
