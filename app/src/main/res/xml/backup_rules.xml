<?xml version="1.0" encoding="utf-8"?>
<!-- Pre-Android 12 backup rules: allow cloud backup of settings while protecting sensitive databases -->
<full-backup-content>
    <include domain="sharedpref" path="." />
    <exclude domain="sharedpref" path="app_settings.xml" />
    <include domain="database" path="." />
    <exclude domain="database" path="attendance_database" />
</full-backup-content>
